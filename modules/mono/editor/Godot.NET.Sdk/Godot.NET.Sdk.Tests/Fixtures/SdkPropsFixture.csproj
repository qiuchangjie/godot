<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GodotSdkImportsMicrosoftNetSdk>true</GodotSdkImportsMicrosoftNetSdk>
    <AssemblyName>MyGame</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <Configuration>ExportRelease</Configuration>
  </PropertyGroup>
  <!--
  Imports the full Sdk.props chain (which pulls in iOS.props when
  GodotTargetPlatform=ios) and then Sdk.targets, so the platform property files
  participate in evaluation. Use only with a staged copy of the Sdk source
  folder that also contains SdkPackageVersions.props.
  -->
  <Import Project="$(GodotSdkSourceDir)/Sdk.props" />
  <Import Project="$(GodotSdkSourceDir)/Sdk.targets" />
</Project>
