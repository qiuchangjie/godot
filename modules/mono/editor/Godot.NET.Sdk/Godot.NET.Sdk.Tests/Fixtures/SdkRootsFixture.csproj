<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GodotSdkImportsMicrosoftNetSdk>true</GodotSdkImportsMicrosoftNetSdk>
    <AssemblyName>MyGame</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <Configuration>ExportRelease</Configuration>
  </PropertyGroup>
  <!-- Imported from the source tree so the test measures the working copy, not the NuGet cache. -->
  <!-- Forward slash keeps the fixture valid on Windows and Unix alike. -->
  <Import Project="$(GodotSdkSourceDir)/Sdk.targets" />
</Project>
